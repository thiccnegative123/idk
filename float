game.StarterGui:SetCore("SendNotification", {
    Title = "press g to start it";
    Text = "Made by Haxarebest2";
    Duration = 5
})

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = game.Players.LocalPlayer

local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

local platform = nil
local active = false
local topHeight = 0   -- height of the platform's TOP surface
local speed = 0.3

local originalCollide = {}

local function disableAllCollide()
	for _, part in ipairs(workspace:GetDescendants()) do
		if part:IsA("BasePart") and part ~= platform then
			originalCollide[part] = part.CanCollide
			part.CanCollide = false
		end
	end
end

local function restoreCollide()
	for part, canCollide in pairs(originalCollide) do
		if part and part.Parent then
			part.CanCollide = canCollide
		end
	end
	originalCollide = {}
end

local function disablePlatform()
	active = false
	restoreCollide()
	if platform then
		platform:Destroy()
		platform = nil
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.G then
		if not active then
			active = true

			platform = Instance.new("Part")
			platform.Size = Vector3.new(10, 6, 10) -- thicker
			platform.Anchored = true
			platform.CanCollide = true
			platform.Transparency = 1 -- semi-visible so you can see it
			platform.Parent = workspace

			-- set top surface just under the feet
			topHeight = rootPart.Position.Y - (rootPart.Size.Y / 2) - humanoid.HipHeight - 0.1

			disableAllCollide()
		else
			disablePlatform()
		end
	end
end)

humanoid.Died:Connect(function()
	disablePlatform()
end)

player.CharacterAdded:Connect(function(newCharacter)
	character = newCharacter
	rootPart = newCharacter:WaitForChild("HumanoidRootPart")
	humanoid = newCharacter:WaitForChild("Humanoid")

	for _, part in ipairs(newCharacter:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = true
		end
	end

	humanoid.Died:Connect(function()
		disablePlatform()
	end)

	if active then
		topHeight = rootPart.Position.Y - (rootPart.Size.Y / 2) - humanoid.HipHeight - 0.1
	end
end)

RunService.Heartbeat:Connect(function()
	if not active or not platform then return end

	if UserInputService:IsKeyDown(Enum.KeyCode.Q) then
		topHeight = topHeight - speed
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.T) then
		topHeight = topHeight + speed
	end

	-- position so the TOP of the platform is at topHeight
	platform.CFrame = CFrame.new(
		rootPart.Position.X,
		topHeight - (platform.Size.Y / 2),
		rootPart.Position.Z
	)
end)

print("Press G to toggle platform, Q to lower, T to raise")
