local function saveState()
    if type(writefile) ~= "function" then
        addMessage("ERROR", "Executor does not support writefile.", RED)
        return
    end

    local chatMessages = {}

    for _, item in ipairs(chat:GetChildren()) do
        if item:IsA("TextLabel") then
            local c = item.TextColor3

            table.insert(chatMessages, {
                text = item.Text,
                color = {
                    math.floor(c.R * 255),
                    math.floor(c.G * 255),
                    math.floor(c.B * 255)
                }
            })
        end
    end

    local data = {
        version = 11,

        -- API configuration
        apiKey = keyBox.Text,
        personality = personality.Text,
        selectedModel = selectedModel,

        -- Settings
        radius = RADIUS,
        autoSpeak = AUTO_SPEAK,
        testMode = testMode,
        circleVisible = circleVisible,

        -- AI memories
        history = history,
        playerMemory = playerMemory,

        -- Blocked players
        blockedPlayers = blockedPlayers,

        -- Displayed messages
        chatMessages = chatMessages
    }

    local ok, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not ok then
        addMessage("ERROR", "Could not encode save data: " .. tostring(encoded), RED)
        return
    end

    local success, err = pcall(function()
        writefile(SAVE_FILE, encoded)
    end)

    if success then
        addMessage("SYSTEM", "Successfully saved everything to " .. SAVE_FILE, GREEN)
        saveButton.Text = "SAVED!"

        task.delay(2, function()
            if saveButton and saveButton.Parent then
                saveButton.Text = "SAVE"
            end
        end)
    else
        addMessage("ERROR", "Save failed: " .. tostring(err), RED)
    end
end

