        if type(info) == "table" and info.name then
            seen[id] = true
            table.insert(lines, formatInfo(info) .. " (permanent /graball data)")
        end
    end
    for id, info in pairs(grabbedInfo) do
        if type(info) == "table" and info.name and not seen[id] then
            table.insert(lines, formatInfo(info))
        end
    end
    return table.concat(lines, "\n")
end

local function stringKeys(map)
    local result = {}
    for id, value in pairs(map) do result[tostring(id)] = value end
    return result
end

local function buildChatSnapshot()
    local chatMessages = {}
    for _, child in ipairs(chat:GetChildren()) do
        if child:IsA("TextLabel") then
            local color = child.TextColor3
            table.insert(chatMessages, {
                text = child.Text,
                order = child.LayoutOrder,
                color = {
                    math.floor(color.R * 255 + 0.5),
                    math.floor(color.G * 255 + 0.5),
                    math.floor(color.B * 255 + 0.5)
                }
            })
        end
    end
    table.sort(chatMessages, function(a, b) return a.order < b.order end)
    while #chatMessages > 100 do table.remove(chatMessages, 1) end
    return chatMessages
end

local function persistState()
    if type(writefile) ~= "function" then return false, "writefile unavailable." end
    local ok, err = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode({
            version = 18,
            apiKey = keyBox.Text:gsub("%s", ""),
            personality = personalityBox.Text,
            selectedModel = selectedModel,
            selectedModelId = MODELS[selectedModel].id,
            radius = radius,
            autoSpeak = autoSpeak,
            testMode = testMode,
            circleVisible = circleVisible,
            restrictToAllowed = restrictToAllowed,
            noCooldown = noCooldown,
            allowCommands = allowCommands,
            loopGrabEnabled = loopGrabEnabled,
            gameSnapshot = gameSnapshot,
            permanentInfo = stringKeys(permanentInfo),
            history = history,
            playerMemory = stringKeys(playerMemory),
            blockedPlayers = stringKeys(blockedPlayers),
            allowedPlayers = stringKeys(allowedPlayers),
            grabbedInfo = stringKeys(grabbedInfo),
            chatMessages = buildChatSnapshot()
        }))
    end)
    if not ok then return false, tostring(err) end
    return true
end

