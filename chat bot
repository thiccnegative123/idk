local function collectInfo(target)
    local friendIds = {}
    local count = 0

    local ok = pcall(function()
        local pages = Players:GetFriendsAsync(target.UserId)

        while true do
            for _, friend in ipairs(pages:GetCurrentPage()) do
                if not friendIds[friend.Id] then
                    friendIds[friend.Id] = true
                    count = count + 1
                end
            end

            if pages.IsFinished then
                break
            end

            pages:AdvanceToNextPageAsync()
        end
    end)

    local serverFriends = {}

    if ok then
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= target and friendIds[other.UserId] then
                table.insert(serverFriends, other.Name)
            end
        end
    end

    table.sort(serverFriends)

    return {
        name = target.Name,
        accountAge = target.AccountAge,
        friendCount = ok and count or nil,
        friendsInServer = serverFriends,
        friendsKnown = ok,
        collectedAt = os.time()
    }
end

local function formatInfo(info)
    local count = info.friendCount ~= nil
        and tostring(info.friendCount)
        or "Unknown (lookup failed)"

    local inServer = "Unknown (lookup failed)"

    if info.friendsKnown then
        inServer = #info.friendsInServer > 0
            and table.concat(info.friendsInServer, ", ")
            or "None"
    end

    return "@" .. info.name
        .. " | Account age: " .. tostring(info.accountAge) .. " days"
        .. " | Friends: " .. count
        .. " | Friends in server: " .. inServer
end

local function grabbedContext()
    local lines = {}

    for _, info in pairs(grabbedInfo) do
        if type(info) == "table" and info.name then
            table.insert(lines, formatInfo(info))
        end
    end

    return table.concat(lines, "\n")
end

