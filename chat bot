-- TOKENS: lists every provider with its remaining token allowance and what one
-- reply costs. OpenRouter (credits + free-model daily quota) and AI Horde
-- (kudos) are queried live; the rest have no token balance at all, so they
-- report "inf" and are capped by requests per minute/day instead.
local tokensBusy = false

connect(tokensButton.MouseButton1Click, function()
    if tokensBusy then return end
    tokensBusy = true
    tokensButton.Text = "CHECKING..."

    addMessage("TOKENS", "Remaining tokens and cost per reply, for every provider:", BLUE)

    task.spawn(function()
        for index, provider in ipairs(PROVIDERS) do
            if not session.alive then break end

            local key = apiKeys[provider.id]
            if index == selectedProvider then key = keyBox.Text end

            local live, liveError = livePoints(provider, key)
            local record = quotaRecord(provider)
            local value = live or record.quota or provider.quotaStatic
            local line = provider.name
                .. " | Tokens left: " .. tostring(value)
                .. " | Cost/reply: " .. provider.tokenCost

            if not live and liveError and liveError ~= "no balance endpoint" then
                line = line .. "  (" .. liveError .. ")"
            end
            if record.lastTokens then
                line = line .. string.format("  [last reply %d tokens, %d total in %d replies]",
                    record.lastTokens, record.totalTokens, record.replies)
            end

            addMessage("TOKENS", line, live and GREEN or WHITE)
            task.wait(0.05)
        end

        if session.alive then
            addMessage("TOKENS",
                "Live numbers need that provider's key saved with SAVE. "
                    .. "\"inf\" = the provider has no token balance, it is capped by "
                    .. "requests per minute/day instead. Providers that report usage "
                    .. "update the bottom TOKENS line after every reply.", ORANGE)
            tokensButton.Text = "TOKENS"
        end

        tokensBusy = false
    end)
end)

