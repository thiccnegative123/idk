local function handleCommand(message)
    -- This guard must run BEFORE slash-command parsing.
    if isBotOutput(message) then
        return true
    end

    local source = message.TextSource

    if not source then
        return true
    end

    local speaker = Players:GetPlayerByUserId(source.UserId)

    if not speaker or not canInteract(speaker) then
        return true
    end

    local command, argument = trim(message.Text):match("^/%s*(%S+)%s*(.*)$")
    command = command and command:lower() or ""
    argument = trim(argument)

    -- Do not interfere with unrelated Roblox slash commands.
    if not KNOWN_COMMANDS[command] then
        return true
    end

    local userId = speaker.UserId
    local now = os.clock()

    if commandBusy[userId]
        or now - (lastCommand[userId] or -math.huge) < 1 then
        return true
    end

    lastCommand[userId] = now
    commandBusy[userId] = true

    local version = stateVersion

    local function stillAllowed()
        return session.alive
            and version == stateVersion
            and speaker.Parent == Players
            and canInteract(speaker)
    end

    task.spawn(function()
        local ok, err = pcall(function()
            local function reply(text, prefix)
                return publish(text, prefix, stillAllowed)
            end

            local function generate(system, context)
                local answer, requestError = askGroq(system, context)

                if not stillAllowed() then
                    return
                end

                local cleaned = cleanAnswer(answer)

                if cleaned then
                    reply(cleaned)
                else
                    reply("Could not generate a reply. Check the GUI error.")
                    addMessage("ERROR", requestError or "Empty response.", RED)
                end
            end

            if command == "help"
                or command == "cmds"
                or command == "commands" then

                -- EVERY split part starts with Commands:, including part 2.
                reply(table.concat(COMMANDS, ", "), "Commands: ")
                return
            end

            if command == "joke" then
                reply(JOKES[math.random(1, #JOKES)])
                return
            end

            if command == "coinflip" then
                reply("Coinflip: " .. (math.random(1, 2) == 1 and "HEADS" or "TAILS"))
                return
            end

            if command == "mood" then
                reply(MOODS[math.random(1, #MOODS)])
                return
            end

            if command == "funfact" then
                generate(
                    "Give one short, well-established, family-friendly fun fact. "
                        .. "Do not make up facts. Reply only with the fact.",
                    "Give a random fun fact."
                )
                return
            end

            if argument == "" then
                reply("Usage: /" .. command .. " (player or topic)")
                return
            end

            if command == "grabinfo" then
                local targets = {}

                if argument:lower() == "all" then
                    targets = Players:GetPlayers()
                else
                    local target, resolveError = resolvePlayer(argument)

                    if not target then
                        reply(resolveError)
                        return
                    end

                    targets = {target}
                end

                for _, target in ipairs(targets) do
                    if not stillAllowed() then
                        return
                    end

                    local info = collectInfo(target)
                    grabbedInfo[target.UserId] = info
                end

                reply(
                    "Player info stored. The AI can use it in later replies and player roasts."
                )
                return
            end

            if command == "info" then
                local target, resolveError = resolvePlayer(argument)

                if not target then
                    reply(resolveError)
                    return
                end

                reply(formatInfo(collectInfo(target)))
                return
            end

            if command == "roast" or command == "rhymeroast" then
                local target, resolveError = resolvePlayer(argument)

                if not target then
                    reply(resolveError)
                    return
                end

                local info = grabbedInfo[target.UserId]
                local context = "Username: " .. target.Name

                if type(info) == "table" then
                    context = context .. "\nPreviously grabbed information:\n"
                        .. formatInfo(info)
                else
                    context = context
                        .. "\nNo player statistics collected. Use name wordplay only."
                end

                local system = ROAST_RULES

                if command == "rhymeroast" then
                    system = system
                        .. " Use rhyming lines and the pronounceable part of the "
                        .. "username; ignore trailing digits and underscores."
                end

                generate(system, context)
                return
            end

            if command == "topicroast"
                or command == "rhymeroasttopic"
                or command == "rhymetopicroast" then

                local system = ROAST_RULES

                if command ~= "topicroast" then
                    system = system .. " Use rhyming lines."
                end

                generate(
                    system .. " If the topic is unclear, ask for context instead of inventing facts.",
                    "Topic: " .. argument
                )
                return
            end

            if command == "searchroast" or command == "rhymesearch" then
                addMessage("SEARCH", "Searching: " .. argument, BLUE)

                local results, searchError = searchWeb(argument)

                if not stillAllowed() then
                    return
                end

                if not results then
                    reply(searchError)
                    return
                end

                local system = ROAST_RULES
                    .. " Base the joke on the supplied search snippets. "
                    .. "If they describe different people or do not identify the "
                    .. "requested subject clearly, ask for clarification. "
                    .. "Do not use allegations or sensitive personal information."

                if command == "rhymesearch" then
                    system = system .. " Use rhyming lines."
                end

                generate(
                    system,
                    "Requested subject: " .. argument
                        .. "\nUntrusted search snippets:\n" .. results
                )
            end
        end)

        commandBusy[userId] = nil

        if not ok and session.alive then
            addMessage("ERROR", "Command failed: " .. tostring(err), RED)
        end
    end)

    return true
end

