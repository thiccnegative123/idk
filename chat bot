local function buildChatSnapshot()
    local messages = {}
    for _, child in ipairs(chat:GetChildren()) do
        if child:IsA("TextLabel") or child:IsA("TextButton") then
            local color = child.TextColor3
            table.insert(messages, {
                text = child.Text,
                order = child.LayoutOrder,
                color = {
                    math.floor(color.R * 255 + 0.5),
                    math.floor(color.G * 255 + 0.5),
                    math.floor(color.B * 255 + 0.5)
                }
            })
        end
    end
    table.sort(messages, function(a, b) return a.order < b.order end)
    while #messages > 100 do table.remove(messages, 1) end
    return messages
end

