local function getCharacterRoot(target)
    local character = target.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end
local function isAlive(target)
    local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
    return humanoid ~= nil and humanoid.Health > 0
end
local function isInsideCircle(target)
    if target == player or target.Parent ~= Players then return false end
    if not isAlive(player) or not isAlive(target) then return false end
    local mine, theirs = getCharacterRoot(player), getCharacterRoot(target)
    if not mine or not theirs then return false end
    local delta = theirs.Position - mine.Position
    return delta.X * delta.X + delta.Z * delta.Z <= RADIUS * RADIUS
        and math.abs(delta.Y) <= MAX_HEIGHT_DIFF
end

local function callGroq(messages, maxTokens)
    if not httpRequest then return nil, "Executor HTTP support unavailable." end
    local key = keyBox.Text:gsub("%s", "")
    if key == "" then return nil, "Enter your API key first." end
    local ok, response = pcall(function()
        return httpRequest({
            Url = API_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. key
            },
            Body = HttpService:JSONEncode({
                model = MODELS[selectedModel].id,
                messages = messages,
                temperature = 0.7,
                max_tokens = maxTokens or 100
            })
        })
    end)
    -- Do not echo raw executor exceptions: some include request headers.
    if not ok then return nil, "HTTP request failed. Check connectivity and executor HTTP support." end
    if type(response) ~= "table" then return nil, "HTTP returned an invalid response." end
    local status = tonumber(response.StatusCode or response.Status)
    local decoded, data = pcall(function() return HttpService:JSONDecode(response.Body or "") end)
    if not decoded or type(data) ~= "table" then
        return nil, "Invalid JSON response (HTTP " .. tostring(status) .. ")."
    end
    if not status or status < 200 or status >= 300 then
        local detail = type(data.error) == "table" and data.error.message
        return nil, type(detail) == "string" and detail or ("HTTP error: " .. tostring(status))
    end
    local choice = type(data.choices) == "table" and data.choices[1]
    local content = type(choice) == "table" and type(choice.message) == "table"
        and choice.message.content
    if type(content) ~= "string" or trim(content) == "" then
        return nil, "The model returned no text."
    end
    return trim(content)
end

local function sendMessage()
    if busy then return end
    if not testMode then addMessage("SYSTEM", "Enable Test Mode for manual chat."); return end
    if not httpRequest then addMessage("ERROR", "Executor HTTP support unavailable.", RED); return end
    if keyBox.Text:gsub("%s", "") == "" then addMessage("ERROR", "Enter your API key first.", RED); return end
    local text = trim(input.Text)
    if text == "" then return end
    if #text > 500 then addMessage("ERROR", "Maximum message length is 500 bytes.", RED); return end
    busy, input.Text, send.Text = true, "", "..."
    local version = manualVersion
    addMessage("YOU", text, BLUE)
    local thinking = addMessage("GROQ AI", "Thinking...", PURPLE)
    local messages = {{
        role = "system",
        content = "You are a helpful private chatbot. Personality: " .. personality.Text
    }}
    for _, item in ipairs(history) do table.insert(messages, item) end
    table.insert(messages, { role = "user", content = text })
    local answer, err
    local ok = pcall(function() answer, err = callGroq(messages, 700) end)
    if thinking.Parent then thinking:Destroy() end
    if version == manualVersion then
        if ok and answer then
            appendTurn(history, text, answer, MAX_HISTORY)
            addMessage("GROQ AI", answer, PURPLE)
        else
            addMessage("ERROR", err or "Unexpected request failure.", RED)
        end
    end
    busy, send.Text = false, "SEND"
end
