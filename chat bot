local function appendTurn(targetHistory, userText, answer, limit)
    table.insert(targetHistory, {
        role = "user",
        content = userText
    })

    table.insert(targetHistory, {
        role = "assistant",
        content = answer
    })

    while #targetHistory > limit do
        table.remove(targetHistory, 1)
        table.remove(targetHistory, 1)
    end
end

