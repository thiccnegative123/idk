    circleVisible = not circleVisible
    updateCircleVisibility()
    refreshButtons()
end)

updateCircleVisibility()

local frameCount = 0

connect(RunService.Heartbeat, function()
    frameCount = frameCount + 1
    if frameCount < 3 then return end
    frameCount = 0
    local circle = session.circle
    if not circle or not circle.Parent then return end
    local character = player.Character
    local mine = root(player)
    if not character or not mine or not alive(player) then
        circle.Transparency = 1
        return
    end
    local filter = {circle}
    table.insert(filter, character)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    local ok, hit = pcall(function()
        return workspace:Raycast(mine.Position, Vector3.new(0, -100, 0), params)
    end)
    if not ok then return end
    local groundY = hit and hit.Position.Y or mine.Position.Y - 3
    circle.Size = Vector3.new(0.15, radius * 2, radius * 2)
    circle.CFrame = CFrame.new(mine.Position.X, groundY + 0.1, mine.Position.Z)
        * CFrame.Angles(0, 0, math.rad(90))
    circle.Transparency = 0.75
end)

