local function resolvePlayer(query)
    query = trim(query):lower():gsub("^@", "")

    if query == "me" then
        return player
    end

    if query == "" then
        return nil, "Enter a username or unique prefix."
    end

    local matches = {}

    for _, target in ipairs(Players:GetPlayers()) do
        local name = target.Name:lower()

        if name == query then
            return target
        end

        if name:sub(1, #query) == query then
            table.insert(matches, target)
        end
    end

    if #matches == 1 then
        return matches[1]
    end

    return nil, #matches == 0
        and "Player not found."
        or "Multiple matches. Type more of the username."
end

local function root(target)
    return target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")
end

local function alive(target)
    local humanoid = target.Character
        and target.Character:FindFirstChildOfClass("Humanoid")

    return humanoid and humanoid.Health > 0
end

local function insideCircle(target)
    if target == player or target.Parent ~= Players then
        return false
    end

    local mine = root(player)
    local theirs = root(target)

    if not mine or not theirs or not alive(player) or not alive(target) then
        return false
    end

    local delta = theirs.Position - mine.Position

    return delta.X * delta.X + delta.Z * delta.Z <= radius * radius
        and math.abs(delta.Y) <= 15
end

local function canInteract(target)
    if target == player then
        return true
    end

    if blockedPlayers[target.UserId] then
        return false
    end

    if allowedPlayers[target.UserId] then
        return true
    end

    if restrictToAllowed then
        return false
    end

    return insideCircle(target)
end

local function validJob(job)
    return session.alive
        and autoSpeak
        and job.stateVersion == stateVersion
        and job.playerVersion == (playerVersions[job.userId] or 0)
        and Players:GetPlayerByUserId(job.userId) == job.player
        and canInteract(job.player)
end

