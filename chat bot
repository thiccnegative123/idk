local function updateCircleVisibility()
    if not circleVisible and session.circle then
        session.circle:Destroy()
        session.circle = nil
    elseif circleVisible and not session.circle then
        session.circle = create("Part", {
            Name = "PrivateGroqAI_Circle",
            Shape = Enum.PartType.Cylinder,
            Size = Vector3.new(0.15, radius * 2, radius * 2),
            Material = Enum.Material.Neon,
            Color = PURPLE,
            Transparency = 1,
            Anchored = true,
            CanCollide = false,
            CanTouch = false,
            CanQuery = false,
            CastShadow = false
        }, workspace)
    end
end

connect(circleButton.MouseButton1Click, function()
    circleVisible = not circleVisible
    updateCircleVisibility()
    refreshButtons()
end)

updateCircleVisibility()

local frameCount = 0

connect(RunService.Heartbeat, function()
    frameCount = frameCount + 1

    if frameCount < 3 then
        return
    end

    frameCount = 0
    local circle = session.circle

    if not circle then
        return
    end

    local mine = root(player)

    if not mine or not alive(player) then
        circle.Transparency = 1
        return
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {player.Character, circle}

    local hit = workspace:Raycast(
        mine.Position,
        Vector3.new(0, -100, 0),
        params
    )

    local groundY = hit and hit.Position.Y or mine.Position.Y - 3

    circle.Size = Vector3.new(0.15, radius * 2, radius * 2)

    circle.CFrame = CFrame.new(
        mine.Position.X,
        groundY + 0.1,
        mine.Position.Z
    ) * CFrame.Angles(0, 0, math.rad(90))

    circle.Transparency = 0.75
end)

