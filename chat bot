local function updateCircleVisibility()
    if not circleVisible then
        if session.circle then
            session.circle:Destroy()
            session.circle = nil
        end
        return
    end
    if session.circle and session.circle.Parent then return end
    local ok, part = pcall(function()
        return create("Part", {
            Name = "PrivateGroqAI_Circle",
            Shape = Enum.PartType.Cylinder,
            Size = Vector3.new(0.15, radius * 2, radius * 2),
            Material = Enum.Material.Neon,
            Color = PURPLE,
            Transparency = 1,
            Anchored = true,
            CanCollide = false,
            CanTouch = false,
            CanQuery = false,
            CastShadow = false
        }, workspace)
    end)
    session.circle = ok and part or nil
end

