--==================================================

local function sendMessage()
    if busy then return end

    if not testMode then
        addMessage("SYSTEM", "Enable Test Mode for manual chat.")
        return
    end

    if not httpRequest then
        addMessage("ERROR", "Executor HTTP support unavailable.", RED)
        return
    end

    if keyBox.Text:gsub("%s", "") == "" then
        addMessage("ERROR", "Enter your API key first.", RED)
        return
    end

    local text = trim(input.Text)

    if text == "" then return end

    if #text > 500 then
        addMessage("ERROR", "Maximum message length is 500 bytes.", RED)
        return
    end

    busy = true
    input.Text = ""
    send.Text = "..."

    local version = manualVersion

    addMessage("YOU", text, BLUE)

    local thinking = addMessage("GROQ AI", "Thinking...", PURPLE)

    local messages = {{
        role = "system",
        content = "You are a helpful private chatbot. Personality: "
            .. personality.Text
    }}

    for _, item in ipairs(history) do
        table.insert(messages, item)
    end

    table.insert(messages, {
        role = "user",
        content = text
    })

    local answer, err

    local ok = pcall(function()
        answer, err = callGroq(messages, 700)
    end)

    if thinking.Parent then
        thinking:Destroy()
    end

    if version == manualVersion then
        if ok and answer then
            appendTurn(history, text, answer, MAX_HISTORY)
            addMessage("GROQ AI", answer, PURPLE)
        else
            addMessage("ERROR", err or "Unexpected request failure.", RED)
        end
    end

    busy = false
    send.Text = "SEND"
end

send.MouseButton1Click:Connect(sendMessage)

input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendMessage()
    end
end)

