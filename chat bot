local ttsSpeaker, ttsOutput, ttsWire = nil, nil, nil
local ttsUnavailable = false

-- Builds the 2D speech chain once: AudioTextToSpeech -> Wire -> AudioDeviceOutput,
-- all parented to SoundService (Roblox's own layout for non-directional speech).
local function ensureTts()
    if ttsSpeaker and ttsSpeaker.Parent then return true end
    if ttsUnavailable then return false end
    local ok = pcall(function()
        local soundService = game:GetService("SoundService")
        local output = Instance.new("AudioDeviceOutput")
        output.Name = "PrivateGroqAI_TTSOutput"
        output.Parent = soundService
        local speaker = Instance.new("AudioTextToSpeech")
        speaker.Name = "PrivateGroqAI_TTS"
        speaker.Volume = 2
        speaker.Parent = soundService
        local wire = Instance.new("Wire")
        wire.Name = "PrivateGroqAI_TTSWire"
        wire.SourceInstance = speaker
        wire.TargetInstance = output
        wire.Parent = soundService
        ttsOutput, ttsSpeaker, ttsWire = output, speaker, wire
    end)
    if not ok or not ttsSpeaker then
        ttsUnavailable = true
        return false
    end
    return true
end

-- Speaks a string with the selected voice. Roblox caps each request at 300
-- characters, so longer text is clipped on a UTF-8 boundary. Safe to call when
-- TTS is off or the executor/Roblox build does not support audio objects.
local function ttsSpeak(text)
    if not ttsEnabled or not session.alive then return end
    text = trim(tostring(text or ""))
    if text == "" then return end
    if utf8.len(text) and utf8.len(text) > 300 then
        local cut = utf8.offset(text, 301)
        if cut then text = text:sub(1, cut - 1) end
    end
    if not ensureTts() then return end
    local voice = TTS_VOICES[ttsVoiceIndex] or TTS_VOICES[2]
    pcall(function()
        ttsSpeaker.VoiceId = voice.id
        ttsSpeaker.Text = text
        ttsSpeaker.Volume = 2
        ttsSpeaker:Play()
    end)
end

