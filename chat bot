local function submitQuizTopic()
    local topic = trim(quizTopicBox.Text)
    if topic == "" then
        addMessage("QUIZ", "Enter a topic, for example Minecraft.", ORANGE)
        return
    end
    if activeQuiz or quizGenerating then
        addMessage("QUIZ", "A quiz is already running or generating.", ORANGE)
        return
    end
    handleCommand({
        Text = "/quiz " .. topic,
        TextSource = {UserId = player.UserId},
        Metadata = ""
    })
end

connect(quizButton.MouseButton1Click, submitQuizTopic)
connect(quizTopicBox.FocusLost, function(enterPressed)
    if enterPressed then submitQuizTopic() end
end)

local function sendManual()
    local text = trim(inputBox.Text)
    if text == "" then return end

    if text:sub(1, 1) == "/" then
        inputBox.Text = ""
        handleCommand({
            Text = text,
            TextSource = {UserId = player.UserId},
            Metadata = ""
        })
        return
    end

    if handleQuizAnswer(player.UserId, text) then
        inputBox.Text = ""
        return
    end

    if not testMode then
        addMessage("SYSTEM", "Enable TEST for manual AI chat.", BLUE)
        return
    end

    if manualBusy then return end
    manualBusy = true
    inputBox.Text = ""
    sendButton.Text = "..."
    addMessage("YOU", text, BLUE)
    local version = manualVersion

    task.spawn(function()
        local ok, err = pcall(function()
            local messages = {{
                role = "system",
                content = "You are a helpful chatbot. " .. personalityRule()
                    .. "\nCollected player info, possibly outdated:\n" .. allGrabbedContext()
                    .. "\n" .. gameContextOrNote()
            }}
            for _, item in ipairs(history) do table.insert(messages, item) end
            table.insert(messages, {role = "user", content = text})
            local answer, requestError = callGroq(messages, 900)
            if session.alive and version == manualVersion then
                if answer then
                    appendTurn(history, text, answer)
                    addMessage("AI", answer, PURPLE)
                else
                    addMessage("ERROR", requestError, RED)
                end
            end
        end)
        manualBusy = false
        if session.alive then
            sendButton.Text = "SEND"
            if not ok then addMessage("ERROR", tostring(err), RED) end
        end
    end)
end

connect(sendButton.MouseButton1Click, sendManual)
connect(inputBox.FocusLost, function(enterPressed)
    if enterPressed then sendManual() end
end)

