local function setRadiusFromX(x)
    if sliderBack.AbsoluteSize.X <= 0 then return end

    local rel = math.clamp(
        (x - sliderBack.AbsolutePosition.X)
        / sliderBack.AbsoluteSize.X,
        0,
        1
    )

    RADIUS = math.floor(1 + rel * 499)
    rel = (RADIUS - 1) / 499

    radiusLabel.Text = "RADIUS: " .. RADIUS .. " studs"
    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
    sliderKnob.Position = UDim2.new(rel, -9, 0.5, -9)

    if CircleVisual then
        CircleVisual.Size = Vector3.new(0.2, RADIUS * 2, RADIUS * 2)
    end
end

local function startSlider(event)
