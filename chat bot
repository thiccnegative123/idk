local function changeAccess(box, destination, enabled)
    local target, err = resolvePlayer(box.Text)
    if not target then
        if not enabled then
            local query = trim(box.Text):lower():gsub("^@", "")
            local matches = {}
            for id, name in pairs(destination) do
                local lowerName = tostring(name):lower()
                if lowerName == query then
                    destination[id] = nil
                    invalidateReplies()
                    addMessage("SYSTEM", "Removed " .. tostring(name), BLUE)
                    return
                end
                if query ~= "" and lowerName:sub(1, #query) == query then
                    table.insert(matches, id)
                end
            end
            if #matches == 1 then
                local id = matches[1]
                local name = destination[id]
                destination[id] = nil
                invalidateReplies()
                addMessage("SYSTEM", "Removed " .. tostring(name), BLUE)
                return
            end
        end
        addMessage("ERROR", err, RED)
        return
    end
    if target == player then
        addMessage("ERROR", "Your own access is always enabled.", RED)
        return
    end
    destination[target.UserId] = enabled and target.Name or nil
    box.Text = target.Name
    playerVersions[target.UserId] = (playerVersions[target.UserId] or 0) + 1
    if destination == blockedPlayers and enabled then
        playerMemory[target.UserId] = nil
    end
    invalidateReplies()
    addMessage("SYSTEM",
        destination == allowedPlayers and enabled
            and "Access updated for @" .. target.Name .. " (can talk from anywhere)."
            or "Access updated for @" .. target.Name, BLUE)
end

