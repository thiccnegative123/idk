local session = {alive = true, connections = {}, gui = nil, circle = nil}
function session.stop()
    session.alive = false
    for _, c in ipairs(session.connections) do c:Disconnect() end
    if session.circle then session.circle:Destroy() end
    if session.gui then session.gui:Destroy() end
end
ENV[SESSION_KEY] = session

local function connect(signal, callback)
    local c = signal:Connect(function(...)
        if session.alive then callback(...) end
    end)
    table.insert(session.connections, c)
    return c
end

local function trim(value) return tostring(value or ""):match("^%s*(.-)%s*$") end

local function create(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties) do object[key] = value end
    object.Parent = parent
    return object
end

local function round(object, radius)
    create("UICorner", {CornerRadius = UDim.new(0, radius or 6)}, object)
end

