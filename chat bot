local providerQuota = {}

local function quotaRecord(provider)
    local record = providerQuota[provider.id]
    if not record then
        record = {quota = nil, note = nil, lastTokens = nil, totalTokens = 0, replies = 0}
        providerQuota[provider.id] = record
    end
    return record
end

-- Remember, per provider, that its free allowance ran out. It is only honoured
-- for the same calendar day (most free tiers reset daily), so re-running the
-- script does not show "inf" again for an allowance we already know is gone.
local savedQuotaErrors = type(saved.quotaErrors) == "table" and saved.quotaErrors or {}
local quotaDay = os.date and os.date("%Y-%m-%d") or nil

for _, provider in ipairs(PROVIDERS) do
    local info = savedQuotaErrors[provider.id]
    if type(info) == "table" and info.text
        and (quotaDay == nil or info.day == quotaDay) then
        local record = quotaRecord(provider)
        record.quota = info.text
        record.exhausted = true
    end
end

local function refreshQuotaLabel()
    if not session.alive then return end
    local provider = PROVIDERS[selectedProvider]
    local record = quotaRecord(provider)
    local quota = record.quota or provider.quotaStatic or "unknown"
    if record.note then quota = quota .. " (" .. record.note .. ")" end

    -- Cost per reply starts as the provider's published estimate and becomes the
    -- measured average once real replies have been counted, so every provider
    -- ends up showing its own true token cost.
    local cost = tostring(provider.tokenCost or "unknown")
    if record.replies > 0 then
        cost = string.format("%s (measured avg %d tokens/reply)",
            cost, math.floor(record.totalTokens / record.replies))
    end

    local parts = {
        "TOKENS LEFT: " .. quota,
        "COST/REPLY: " .. cost
    }
    if record.lastTokens then
        parts[#parts + 1] = string.format("last reply %d tokens (total %d in %d replies)",
            record.lastTokens, record.totalTokens, record.replies)
    end
    quotaLabel.Text = table.concat(parts, "  |  ")
end

-- Providers that expose a remaining allowance put it in the response headers
-- (Groq and most OpenAI-compatible APIs do this). Header names are matched
-- case-insensitively and the "-day" long window is skipped so the shorter,
-- more useful window wins.
local function quotaFromHeaders(headers)
    if type(headers) ~= "table" then return nil end

    local found = {}
    for name, value in pairs(headers) do
        found[tostring(name):lower()] = tostring(value)
    end

    local function scan(needleA, needleB)
        for key, value in pairs(found) do
            if key:find(needleA, 1, true) and key:find(needleB, 1, true)
                and not key:find("-day", 1, true) then
                return value
            end
        end
        return nil
    end

    local remainingTokens = found["x-ratelimit-remaining-tokens"]
        or scan("remaining", "token")
    local remainingRequests = found["x-ratelimit-remaining-requests"]
        or scan("remaining", "request")

    local parts = {}
    if remainingTokens then
        parts[#parts + 1] = remainingTokens .. " tokens left this window"
    end
    if remainingRequests then
        parts[#parts + 1] = remainingRequests .. " requests left"
    end
    return #parts > 0 and table.concat(parts, ", ") or nil
end

-- Called after every successful reply: stores the real token cost of that
-- message and any refreshed allowance the provider sent back.
local function recordTokenUsage(provider, response, data)
    local record = quotaRecord(provider)

    -- A reply got through, so any earlier "allowance used up" flag was stale
    -- (a new day/window, or a different model). Clear it and fall back to the
    -- provider's published allowance until fresh numbers arrive.
    if record.exhausted then
        record.exhausted = false
        record.quota = nil
        record.note = nil
        savedQuotaErrors[provider.id] = nil
    end

    local usage = type(data) == "table" and data.usage
    if type(usage) == "table" then
        local total = tonumber(usage.total_tokens)
        if not total then
            total = (tonumber(usage.prompt_tokens) or 0)
                + (tonumber(usage.completion_tokens) or 0)
        end
        if total and total > 0 then
            record.lastTokens = math.floor(total)
            record.totalTokens = record.totalTokens + math.floor(total)
            record.replies = record.replies + 1
        end
    end

    local fromHeaders = quotaFromHeaders(response and response.Headers)
    if fromHeaders then
        record.quota = fromHeaders
        record.note = nil
    end

    refreshQuotaLabel()
end

-- Providers do not always publish a balance, but they DO refuse calls once the
-- free allowance is gone ("you have used up your daily free allocation of 10000
-- neurons", "insufficient credits", HTTP 402/429 ...). Without this the GUI kept
-- claiming "inf" while the provider was really at zero. Keywords below split a
-- hard "allowance used up" from a soft, temporary rate limit.
local function recordQuotaError(provider, message, status)
    local record = quotaRecord(provider)
    local text = trim(tostring(message or ""))
    local lower = text:lower()
    status = tonumber(status) or 0

    -- Exhaustion keywords win even on HTTP 429: Cloudflare answers 429 with
    -- "you have used up your daily free allocation", which is not a soft limit.
    local exhausted = status == 402
    if not exhausted then
        for _, needle in ipairs({
            "used up", "free allocation", "quota", "insufficient",
            "no credits", "out of credits", "credit balance", "daily limit",
            "monthly limit", "billing", "upgrade to", "not enough",
            -- Daily/weekly caps (Groq answers "tokens per day (TPD): Limit ...
            -- Used ...", OpenAI-compatible APIs say "requests per day").
            "tokens per day", "requests per day", "per day (tpd", "per day (rpd"
        }) do
            if lower:find(needle, 1, true) then exhausted = true break end
        end
    end

    local rateLimited = not exhausted and (status == 429
        or lower:find("rate limit", 1, true)
        or lower:find("too many requests", 1, true)
        or lower:find("slow down", 1, true))

    if exhausted then
        -- Show the provider's own number where it gives one, e.g. Cloudflare's
        -- "10000 neurons". The full error text is already printed in the chat.
        local neurons = lower:find("neuron", 1, true)
        record.quota = neurons and "0 neurons left (daily free allowance used up)"
            or "0 (allowance used up)"
        record.note = nil
        record.exhausted = true
        savedQuotaErrors[provider.id] = {text = record.quota, day = quotaDay}
    elseif rateLimited then
        record.note = "temporarily rate limited"
        record.exhausted = false
    else
        return
    end

    refreshQuotaLabel()
end

-- Runs when a provider is clicked: pulls the live balance where one exists and
-- repaints the quota line straight away.
local function updateProviderQuota(provider, key, announce)
    local record = quotaRecord(provider)
    local live, liveError = livePoints(provider, key)

    if live then
        record.quota = live
        record.note = nil
    elseif liveError and liveError ~= "no balance endpoint" then
        record.note = liveError
    end

    refreshQuotaLabel()

    if announce then
        addMessage("TOKENS", provider.name
            .. " -> TOKENS LEFT: " .. (record.quota or provider.quotaStatic)
            .. " | COST/REPLY: " .. tostring(provider.tokenCost)
            .. (record.note and ("  (" .. record.note .. ")") or ""), BLUE)
    end
end

-- Cloudflare keeps the account id inside the endpoint path. Paste either
-- "account_id:api_token" or just the API token: when only a token is given the
-- account id is looked up once through the Cloudflare API and cached per token.
-- Every other provider keeps its plain urls and the whole key box as the token.
local cloudflareAccountByToken = {}

local function cloudflareAccountId(token)
    if cloudflareAccountByToken[token] then
        return cloudflareAccountByToken[token]
    end

    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    -- Try two endpoints that expose the account id. /accounts works when the
    -- token may list accounts; /memberships often still answers for tokens that
    -- are scoped to a single service. The id sits at result[1].id, or at
    -- result[1].account.id for memberships.
    local endpoints = {
        "https://api.cloudflare.com/client/v4/accounts",
        "https://api.cloudflare.com/client/v4/memberships"
    }

    local helpMessage = "Cloudflare could not read your account id from the token. "
        .. "Paste the key as account_id:api_token instead (the account id is on "
        .. "the Workers & Pages page of the Cloudflare dashboard)."
    local tokenMessage = nil

    for _, endpoint in ipairs(endpoints) do
        local ok, response = pcall(function()
            return httpRequest({
                Url = endpoint,
                Method = "GET",
                Headers = {
                    ["Authorization"] = "Bearer " .. token,
                    ["Accept"] = "application/json"
                }
            })
        end)

        if ok and type(response) == "table" then
            local decoded, data = pcall(function()
                return HttpService:JSONDecode(response.Body or "")
            end)

            if decoded and type(data) == "table" then
                local first = type(data.result) == "table" and data.result[1]
                local id = type(first) == "table" and first.id or nil

                if not id and type(first) == "table"
                    and type(first.account) == "table" then
                    id = first.account.id
                end

                if id then
                    cloudflareAccountByToken[token] = tostring(id)
                    return tostring(id)
                end

                if type(data.errors) == "table" and type(data.errors[1]) == "table"
                    and data.errors[1].message then
                    local message = tostring(data.errors[1].message)
                    local lower = message:lower()
                    -- Only surface it when the token itself is the problem;
                    -- a scoped-but-valid token just can't list accounts.
                    if lower:find("invalid", 1, true)
                        or lower:find("authoriz", 1, true)
                        or lower:find("permission", 1, true) then
                        tokenMessage = message
                    end
                end
            end
        end
    end

    return nil, tokenMessage or helpMessage
end

local function providerEndpoints(provider)
    local raw = keyBox.Text:gsub("%s", "")

    if provider.id == "cloudflare" then
        local accountId, token = raw:match("^([^:]+):(.+)$")

        if not accountId then
            -- Only a token was pasted; work out the account id automatically.
            token = raw
            local found, lookupError = cloudflareAccountId(token)
            if not found then
                return nil, nil, nil, lookupError
            end
            accountId = found
        end

        return provider.url:gsub("{account_id}", accountId),
            provider.modelsUrl:gsub("{account_id}", accountId),
            token
    end

    return provider.url, provider.modelsUrl, raw
end

-- AI Horde reports, per model, how many jobs are queued and how many workers
-- serve it. A model with little queue per worker, and few active parameters
-- (MoE ids such as "...-A4B-..." only run the "A" slice), answers first. The
-- top-ranked model is listed first and therefore picked by default.
local function aiHordeSpeedRank(model)
    local id = model.id:lower()

    local params = tonumber(id:match("[%-_][a](%d+%.?%d*)[b]"))
        or tonumber(id:match("[%-_][e](%d+%.?%d*)[b]"))
        or tonumber(id:match("[%-_](%d+%.?%d*)[b]"))
        or 999

    local queued = tonumber(model.queued) or 0
    local workers = tonumber(model.workers) or 0
    local queuePerWorker = workers > 0 and (queued / workers) or (queued + 1)

    return queuePerWorker, params
end

local function fetchProviderModels(provider)
    -- Groq's free tier is a fixed short list. Cloudflare's live catalog also
    -- mixes in deprecated, LoRA and third-party models that answer 400/403 on
    -- the OpenAI-compatible endpoint, so we ship a hand-picked list of free
    -- models that actually work instead of fetching the whole catalog.
    if provider.id == "groq" or provider.id == "cloudflare" then
        return provider.models
    end

    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    local key = keyBox.Text:gsub("%s", "")
    if provider.requiresKey ~= false and key == "" then
        return nil, "Enter your " .. provider.keyName .. " first."
    end

    local _, modelsUrl, token, endpointError = providerEndpoints(provider)
    if not modelsUrl then
        return nil, endpointError
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = modelsUrl,
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. token,
                ["Accept"] = "application/json"
            }
        })
    end)

    if not ok or type(response) ~= "table" then
        return nil, httpFailureHint(provider, 0)
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response.Body or "")
    end)

    local status = tonumber(response.StatusCode or response.Status) or 0
    if not decoded or type(data) ~= "table" or status < 200 or status >= 300 then
        local message = httpFailureHint(provider, status)
        if decoded and type(data) == "table" and type(data.error) == "table"
            and data.error.message then
            message = tostring(data.error.message)
        elseif decoded and type(data) == "table" and type(data.errors) == "table"
            and type(data.errors[1]) == "table" and data.errors[1].message then
            message = tostring(data.errors[1].message)
        end
        return nil, message
    end

    -- OpenAI-compatible providers put the list in "data"; Cloudflare's native
    -- model-search endpoint wraps it in "result" instead.
    local items = data.data
    if type(items) ~= "table" then items = data.result end
    if type(items) ~= "table" then
        return nil, "Provider did not return a model list."
    end

    local models = {}
    for _, item in ipairs(items) do
        local id = type(item) == "table" and item.id or nil

        -- Cloudflare's catalog puts a UUID in "id" and the real callable model
        -- name ("@cf/...") in "name", so prefer whichever field is an @cf id.
        if provider.id == "cloudflare" and type(item) == "table" then
            for _, key in ipairs({"name", "id", "model", "model_name"}) do
                local candidate = item[key]
                if type(candidate) == "string"
                    and candidate:find("@cf/", 1, true) then
                    id = candidate
                    break
                end
            end
        end

        -- Cloudflare's live list may tag each model with a task. Skip anything
        -- that is clearly not a chat/text model (image, audio, embeddings...).
        local nonChat = false
        if provider.id == "cloudflare" and type(item) == "table" then
            local task = item.task
            if type(task) == "table" then task = task.name end
            if type(task) == "string" then
                local lower = task:lower()
                if lower:find("embedding", 1, true) or lower:find("image", 1, true)
                    or lower:find("speech", 1, true) or lower:find("audio", 1, true)
                    or lower:find("classification", 1, true)
                    or lower:find("text-to", 1, true) then
                    nonChat = true
                end
            end
        end

        if type(id) == "string" and id ~= "" and not nonChat
            and (not FREE_ONLY or isFreeModel(provider, item, id)) then
            local family = id:match("^@cf/([^/]+)/") or id:match("^([^/]+)") or "Models"
            local horde = type(item) == "table" and item.x_horde
            horde = type(horde) == "table" and horde or nil
            models[#models + 1] = {
                name = id,
                id = id,
                family = family,
                queued = horde and tonumber(horde.queued) or nil,
                workers = horde and tonumber(horde.workers) or nil
            }
        end
    end

    if #models == 0 then
        return nil, "No free models were returned for this provider."
    end

    if provider.id == "aihorde" then
        -- Rank every model once, then keep families together (the model menu
        -- prints a header per family) while putting the family with the
        -- fastest model first and the fastest model inside each family first.
        local rank = {}
        local familyBest = {}
        for _, model in ipairs(models) do
            local queue, params = aiHordeSpeedRank(model)
            rank[model] = { queue, params }

            local best = familyBest[model.family]
            if not best or queue < best[1]
                or (queue == best[1] and params < best[2]) then
                familyBest[model.family] = { queue, params }
            end
        end

        table.sort(models, function(a, b)
            if a.family ~= b.family then
                local bestA, bestB = familyBest[a.family], familyBest[b.family]
                if bestA[1] ~= bestB[1] then return bestA[1] < bestB[1] end
                if bestA[2] ~= bestB[2] then return bestA[2] < bestB[2] end
                return a.family < b.family
            end

            local rankA, rankB = rank[a], rank[b]
            if rankA[1] ~= rankB[1] then return rankA[1] < rankB[1] end
            if rankA[2] ~= rankB[2] then return rankA[2] < rankB[2] end
            return a.id:lower() < b.id:lower()
        end)
    else
        table.sort(models, function(a, b)
            return a.id:lower() < b.id:lower()
        end)
    end

    return models
end

