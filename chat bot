local function setRadiusFromX(x)
    local width = sliderBack.AbsoluteSize.X
    if width <= 0 then return end
    local fraction = math.clamp((x - sliderBack.AbsolutePosition.X) / width, 0, 1)
    radius = math.floor(1 + fraction * 499 + 0.5)
    local snapped = (radius - 1) / 499
    radiusLabel.Text = "RADIUS: " .. radius .. " studs | F1: hide/show GUI"
    sliderFill.Size = UDim2.new(snapped, 0, 1, 0)
    sliderKnob.Position = UDim2.new(snapped, -9, 0.5, -9)
    if session.circle then
        session.circle.Size = Vector3.new(0.15, radius * 2, radius * 2)
    end
end

