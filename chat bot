local function appendTurn(memory, userText, answer)
    table.insert(memory, {role = "user", content = userText})
    table.insert(memory, {role = "assistant", content = answer})

    while #memory > 20 do
        table.remove(memory, 1)
    end
end

local function resolvePlayer(query)
    query = trim(query):lower():gsub("^@", "")

    if query == "me" then
        return player
    end

    if query == "" then
        return nil, "Enter a username or unique prefix."
    end

    local matches = {}

    for _, target in ipairs(Players:GetPlayers()) do
        local name = target.Name:lower()

        if name == query then
            return target
        end

        if name:sub(1, #query) == query then
            table.insert(matches, target)
        end
    end

    if #matches == 1 then
        return matches[1]
    end

    return nil, #matches == 0
        and "Player not found."
        or "Multiple matches. Type more of the username."
end

local function root(target)
    return target.Character
        and target.Character:FindFirstChild("HumanoidRootPart")
end

local function alive(target)
    local humanoid = target.Character
        and target.Character:FindFirstChildOfClass("Humanoid")

    return humanoid and humanoid.Health > 0
end

local function insideCircle(target)
    if target == player or target.Parent ~= Players then
        return false
    end

    local mine = root(player)
    local theirs = root(target)

    if not mine or not theirs or not alive(player) or not alive(target) then
        return false
    end

    local delta = theirs.Position - mine.Position

    return delta.X * delta.X + delta.Z * delta.Z <= radius * radius
        and math.abs(delta.Y) <= 15
end

local function canInteract(target)
    if target == player then
        return true
    end

    return not blockedPlayers[target.UserId]
        and (not restrictToAllowed or allowedPlayers[target.UserId] ~= nil)
        and insideCircle(target)
end

local function validJob(job)
    return session.alive
        and autoSpeak
        and job.stateVersion == stateVersion
        and job.playerVersion == (playerVersions[job.userId] or 0)
        and Players:GetPlayerByUserId(job.userId) == job.player
        and canInteract(job.player)
end

--==================================================
-- OUTPUT: METADATA + ECHO GUARD + SERIALIZED SENDS
--==================================================

local function normalize(text)
    return trim(text):gsub("%s+", " ")
end

local function rememberOutgoing(text)
    outgoingMessages[normalize(text)] = os.clock() + 120

    for key, expires in pairs(outgoingMessages) do
        if expires < os.clock() then
            outgoingMessages[key] = nil
        end
    end
end

local function isBotOutput(message)
    if message.Metadata == BOT_MESSAGE_METADATA then
        return true
    end

    local text = normalize(message.Text)
    local expires = outgoingMessages[text]

    if expires and expires >= os.clock() then
        return true
    end

    -- Protect every help-list part, not only the first.
    return text:lower():match("^commands:") ~= nil
end

local function splitMessage(text, limit)
    local parts = {}
    local remaining = trim(text):gsub("[\r\n]+", " ")

    while remaining ~= "" do
        local cut = utf8.offset(remaining, limit + 1)

        if not cut then
            table.insert(parts, remaining)
            break
        end

        local candidate = remaining:sub(1, cut - 1)
        local space = candidate:match("^.*()%s")

        if space and space > #candidate / 2 then
            table.insert(parts, trim(remaining:sub(1, space - 1)))
            remaining = trim(remaining:sub(space + 1))
        else
            table.insert(parts, candidate)
            remaining = trim(remaining:sub(cut))
        end
    end

    return parts
end

local function sendChat(text, prefix, validator)
    while sendLocked and session.alive do
        task.wait(0.05)
    end

    if not session.alive then
        return false, "Script stopped."
    end

    sendLocked = true

    local ok, result, detail = pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")

        if not general then
            return false, "RBXGeneral unavailable."
        end

        prefix = prefix or ""
        local limit = 180 - (utf8.len(prefix) or #prefix)
        local parts = splitMessage(text, math.max(40, limit))

        for _, part in ipairs(parts) do
            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end

            local waitTime = GLOBAL_SEND_GAP - (os.clock() - lastPublicSend)

            if waitTime > 0 then
                task.wait(waitTime)
            end

            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end

            local outgoing = prefix .. part

            -- Register BEFORE SendAsync can trigger MessageReceived.
            rememberOutgoing(outgoing)
            lastPublicSend = os.clock()

            general:SendAsync(outgoing, BOT_MESSAGE_METADATA)
        end

        return true
    end)

    sendLocked = false

    if not ok then
        return false, tostring(result)
    end

    return result, detail
end

local function publish(text, prefix, validator)
    local sent, err = sendChat(text, prefix, validator)

    if sent then
        addMessage("BOT", text, PURPLE)
    elseif session.alive and err ~= "Reply canceled." then
        addMessage("ERROR", err, RED)
    end

    return sent
end

