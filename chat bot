local function callGroq(messages, maxTokens)
    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    local key = keyBox.Text:gsub("%s", "")

    if key == "" then
        return nil, "Enter your Groq API key."
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = API_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. key
            },
            Body = HttpService:JSONEncode({
                model = MODELS[selectedModel].id,
                messages = messages,
                temperature = 0.7,
                max_tokens = maxTokens or 500
            })
        })
    end)

    if not ok or type(response) ~= "table" then
        return nil, "Groq HTTP request failed."
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response.Body or "")
    end)

    if not decoded or type(data) ~= "table" then
        return nil, "Groq returned invalid JSON."
    end

    local status = tonumber(response.StatusCode or response.Status) or 0

    if status < 200 or status >= 300 then
        return nil, type(data.error) == "table"
            and tostring(data.error.message)
            or ("Groq HTTP " .. status)
    end

    local choice = data.choices and data.choices[1]
    local content = choice and choice.message and choice.message.content

    if type(content) ~= "string" or trim(content) == "" then
        return nil, "Model returned no text. Try another model."
    end

    return trim(content)
end

local function askGroq(system, user)
    return callGroq({
        {role = "system", content = system},
        {role = "user", content = user}
    }, 700)
end

local function cleanAnswer(text)
    if type(text) ~= "string" then
        return nil
    end

    text = trim(text:gsub("[\r\n]+", " "))

    return text ~= "" and text or nil
end

--==================================================
-- WEB SEARCH
-- HTML SEARCH IS BEST-EFFORT; ERRORS ARE REPORTED.
--==================================================

local function decodeHtml(text)
    return trim(
        text:gsub("<[^>]+>", " ")
            :gsub("&quot;", '"')
            :gsub("&#x27;", "'")
            :gsub("&#39;", "'")
            :gsub("&nbsp;", " ")
            :gsub("&lt;", "<")
            :gsub("&gt;", ">")
            :gsub("&amp;", "&")
            :gsub("%s+", " ")
    )
end

local function searchWeb(query)
    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    local ok, response = pcall(function()
        return httpRequest({
            Url = "https://html.duckduckgo.com/html/?q="
                .. HttpService:UrlEncode(query),
            Method = "GET",
            Headers = {["User-Agent"] = "Mozilla/5.0"}
        })
    end)

    if not ok or type(response) ~= "table" then
        return nil, "Search request failed."
    end

    local status = tonumber(response.StatusCode or response.Status) or 0

    if status < 200 or status >= 300 then
        return nil, "Search HTTP " .. status
    end

    local body = tostring(response.Body or "")
    local results = {}

    for snippet in body:gmatch(
        '<a[^>]-class="result__snippet"[^>]*>(.-)</a>'
    ) do
        local cleaned = decodeHtml(snippet)

        if cleaned ~= "" then
            table.insert(results, cleaned)
        end

        if #results >= 5 then
            break
        end
    end

    if #results == 0 then
        return nil, "Search blocked or no readable results. No roast generated."
    end

    return table.concat(results, "\n\n")
end

