local function isFreeModel(provider, item, id)
    -- Every AI Horde text model is free, so accept whatever the live list returns.
    -- Cloudflare Workers AI models are also all free within the daily allowance.
    if provider.id == "aihorde" or provider.id == "cloudflare" then
        return true
    end

    if provider.id == "logfare" then
        -- Logfare reports an access tier per model. "standard" is free;
        -- "premium" and "pro" need an opt-in, so reject them. Only keep models
        -- that actually serve the chat/completions endpoint (the catalog also
        -- carries image, audio, embedding and "decisions" models).
        if type(item) ~= "table" then
            return FREE_MODEL_IDS.logfare[id] == true
        end

        if type(item.access_tier) == "string" then
            if item.access_tier ~= "standard" then
                return false
            end

            if type(item.endpoints) == "table" then
                for _, endpoint in ipairs(item.endpoints) do
                    if endpoint == "chat/completions" then
                        return true
                    end
                end
                return false
            end

            return true
        end

        return FREE_MODEL_IDS.logfare[id] == true
    end

    if provider.id == "openrouter" then
        if type(id) == "string" and id:find(":free", 1, true) then
            return true
        end

        if type(item) == "table" and type(item.pricing) == "table" then
            local prompt = item.pricing.prompt
            local completion = item.pricing.completion

            if prompt == "0" and completion == "0" then
                return true
            end
        end

        return false
    end

    local allowed = FREE_MODEL_IDS[provider.id]

    if allowed then
        return type(id) == "string" and allowed[id] == true
    end

    if type(item) == "table" and type(item.pricing) == "table" then
        local prompt = item.pricing.prompt
        local completion = item.pricing.completion

        if prompt ~= nil and completion ~= nil then
            return tonumber(prompt) == 0 and tonumber(completion) == 0
        end
    end

    return false
end

-- Turns a missing/failed HTTP response into a message the user can act on.
-- A status of 0 means no response arrived at all (DNS, refused, blocked, TLS).
local function httpFailureHint(provider, status)
    status = tonumber(status) or 0

    if status == 0 then
        return provider.name .. " sent no response (HTTP 0). "
            .. "Check your internet connection; the provider may be blocked or down."
    end

    return provider.name .. " HTTP " .. status
end

--==================================================
-- POINTS / BALANCE
--==================================================
-- Only two of these providers publish a real balance: OpenRouter (credits and
-- the free-model daily quota) and AI Horde (kudos). Every other one is a free
-- tier with no balance at all - it is capped by requests per minute/day, so its
-- points are infinite ("inf") and each message costs 0 points.
local function jsonGet(url, headers)
    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    local ok, response = pcall(function()
        return httpRequest({Url = url, Method = "GET", Headers = headers})
    end)
    if not ok or type(response) ~= "table" then
        return nil, "Request failed."
    end

    local status = tonumber(response.StatusCode or response.Status) or 0
    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response.Body or "")
    end)
    if not decoded or type(data) ~= "table" then
        return nil, "Unreadable reply (HTTP " .. status .. ")."
    end

    if status < 200 or status >= 300 then
        local message = "HTTP " .. status
        if type(data.error) == "table" and data.error.message then
            message = tostring(data.error.message)
        elseif type(data.error) == "string" then
            message = data.error
        elseif type(data.message) == "string" then
            message = data.message
        end
        return nil, message
    end

    return data
end

local function openRouterPoints(key)
    local data, err = jsonGet("https://openrouter.ai/api/v1/key", {
        ["Authorization"] = "Bearer " .. key,
        ["Accept"] = "application/json"
    })
    if not data then return nil, err end

    local info = type(data.data) == "table" and data.data or {}
    local parts = {}

    local remaining = tonumber(info.limit_remaining)
    if remaining then
        parts[#parts + 1] = string.format("%.2f credits left", remaining)
    else
        parts[#parts + 1] = "inf credits (no key limit)"
    end

    local free = info.free_model_daily_requests
    if type(free) == "table" and tonumber(free.remaining) then
        parts[#parts + 1] = string.format("%d of %d free requests left today",
            math.floor(tonumber(free.remaining)), math.floor(tonumber(free.limit) or 0))
    end

    local usage = tonumber(info.usage)
    if usage then
        parts[#parts + 1] = string.format("%.2f credits used all time", usage)
    end

    if info.is_free_tier == true then
        parts[#parts + 1] = "free-tier account"
    end

    return table.concat(parts, " | ")
end

local function aiHordePoints(key)
    local data, err = jsonGet("https://aihorde.net/api/v2/user", {
        ["apikey"] = key,
        ["Accept"] = "application/json",
        ["Client-Agent"] = "PrivateGroqAI:18.6:unknown"
    })
    if not data then return nil, err end

    local kudos = tonumber(data.kudos)
    if not kudos then return nil, "no kudos in the reply" end

    local parts = {string.format("%d kudos", math.floor(kudos))}
    local details = type(data.kudos_details) == "table" and data.kudos_details or {}
    local earned = tonumber(details.earned)
    if earned then
        parts[#parts + 1] = string.format("%d earned from your workers", math.floor(earned))
    end
    local concurrency = tonumber(data.concurrency)
    if concurrency then
        parts[#parts + 1] = concurrency .. " concurrent requests"
    end

    return table.concat(parts, " | ")
end

-- Returns the live balance text, or nil plus a reason when the provider has no
-- balance endpoint (most of them) or no key has been saved yet.
local function livePoints(provider, key)
    key = type(key) == "string" and key:gsub("%s", "") or ""
    if key == "" then
        return nil, "no " .. tostring(provider.keyName) .. " saved yet"
    end

    if provider.id == "openrouter" then return openRouterPoints(key) end
    if provider.id == "aihorde" then return aiHordePoints(key) end

    return nil, "no balance endpoint"
end

