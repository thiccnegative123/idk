--==================================================
-- USERNAME RESOLUTION
--==================================================

local function resolveUsername(query)
    query = string.lower(trim(query):gsub("^@", ""))

    if query == "" then
        return nil, "Enter a username or username prefix."
    end

    local candidates = {}

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then
            candidates[target.UserId] = {
                userId = target.UserId,
                name = target.Name
            }
        end
    end

    for userId, name in pairs(blockedPlayers) do
        candidates[userId] = {
            userId = userId,
            name = name
        }
    end

    local matches = {}

    for _, candidate in pairs(candidates) do
        local name = string.lower(candidate.name)

        if name == query then
            return candidate
        end

        if name:sub(1, #query) == query then
            table.insert(matches, candidate)
        end
    end

    if #matches == 1 then
        return matches[1]
    end

    if #matches == 0 then
        return nil, "No username starts with '" .. query .. "'."
    end

    table.sort(matches, function(a, b)
        return a.name < b.name
    end)

    local names = {}

    for i = 1, math.min(#matches, 6) do
        names[i] = matches[i].name
    end

    return nil, "More than one match: "
        .. table.concat(names, ", ")
        .. ". Type more of the username."
end

--==================================================
-- BLOCK / UNBLOCK
--==================================================

local function setBlocked(shouldBlock)
    local target, err = resolveUsername(blockBox.Text)

    if not target then
        addMessage("SYSTEM", err, RED)
        return
    end

    local userId = target.userId

    if shouldBlock and blockedPlayers[userId] then
        addMessage("SYSTEM", target.name .. " is already blocked.", BLUE)
        return
    elseif not shouldBlock and not blockedPlayers[userId] then
        addMessage("SYSTEM", target.name .. " is not blocked.", BLUE)
        return
    end

    blockedPlayers[userId] = shouldBlock and target.name or nil

    playerVersions[userId] = (playerVersions[userId] or 0) + 1

    pendingPlayers[userId] = nil
    lastMsg[userId] = nil

    for i = #replyQueue, 1, -1 do
        if replyQueue[i].userId == userId then
            table.remove(replyQueue, i)
        end
    end

    if shouldBlock then
        playerMemory[userId] = nil
    end

    blockBox.Text = target.name

    addMessage(
        "SYSTEM",
        target.name .. (
            shouldBlock
            and " blocked. Their messages are ignored and pending replies canceled."
            or " unblocked. Only new messages sent inside the circle can get replies."
        ),
        BLUE
    )
end

