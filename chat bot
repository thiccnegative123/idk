connect(saveButton.MouseButton1Click, function()
    if type(writefile) ~= "function" then
        addMessage("ERROR", "writefile unavailable.", RED)
        return
    end

    local chatMessages = {}

    for _, child in ipairs(chat:GetChildren()) do
        if child:IsA("TextLabel") then
            local color = child.TextColor3

            table.insert(chatMessages, {
                text = child.Text,
                order = child.LayoutOrder,
                color = {
                    math.floor(color.R * 255 + 0.5),
                    math.floor(color.G * 255 + 0.5),
                    math.floor(color.B * 255 + 0.5)
                }
            })
        end
    end

    table.sort(chatMessages, function(a, b)
        return a.order < b.order
    end)

    while #chatMessages > 100 do
        table.remove(chatMessages, 1)
    end

    local function stringKeys(map)
        local result = {}

        for id, value in pairs(map) do
            result[tostring(id)] = value
        end

        return result
    end

    local ok, err = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode({
            version = 18,
            apiKey = keyBox.Text:gsub("%s", ""),
            personality = personalityBox.Text,
            selectedModel = selectedModel,
            selectedModelId = MODELS[selectedModel].id,
            radius = radius,
            autoSpeak = autoSpeak,
            testMode = testMode,
            circleVisible = circleVisible,
            restrictToAllowed = restrictToAllowed,
            noCooldown = noCooldown,
            history = history,
            playerMemory = stringKeys(playerMemory),
            blockedPlayers = stringKeys(blockedPlayers),
            allowedPlayers = stringKeys(allowedPlayers),
            grabbedInfo = stringKeys(grabbedInfo),
            chatMessages = chatMessages
        }))
    end)

    addMessage(
        ok and "SYSTEM" or "ERROR",
        ok and "Saved API key, model, settings and memories." or tostring(err),
        ok and GREEN or RED
    )

    if ok then
        saveButton.Text = "SAVED!"

        task.delay(2, function()
            if session.alive then
                saveButton.Text = "SAVE"
            end
        end)
    end
end)

