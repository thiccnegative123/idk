local function normalize(text) return trim(text):gsub("%s+", " ") end

local function rememberOutgoing(text)
    outgoingMessages[normalize(text)] = os.clock() + 120
    for key, expires in pairs(outgoingMessages) do
        if expires < os.clock() then outgoingMessages[key] = nil end
    end
end

local function isBotOutput(message)
    if message.Metadata == BOT_METADATA then return true end
    local text = normalize(message.Text)
    local expires = outgoingMessages[text]
    if expires and expires >= os.clock() then return true end
    return text:lower():match("^commands:") ~= nil
end

local function splitMessage(text, limit)
    local parts = {}
    local remaining = trim(text):gsub("[\r\n]+", " ")
    while remaining ~= "" do
        local cut = utf8.offset(remaining, limit + 1)
        if not cut then
            table.insert(parts, remaining)
            break
        end
        local candidate = remaining:sub(1, cut - 1)
        local space = candidate:match("^.*()%s")
        if space and space > #candidate / 2 then
            table.insert(parts, trim(remaining:sub(1, space - 1)))
            remaining = trim(remaining:sub(space + 1))
        else
            table.insert(parts, candidate)
            remaining = trim(remaining:sub(cut))
        end
    end
    return parts
end

local function sendChat(text, prefix, validator)
    while sendLocked and session.alive do task.wait(0.05) end
    if not session.alive then return false, "Script stopped." end
    sendLocked = true
    local ok, result, detail = pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")
        if not general then return false, "RBXGeneral unavailable." end
        prefix = prefix or ""
        local limit = 180 - (utf8.len(prefix) or #prefix)
        for _, part in ipairs(splitMessage(text, math.max(40, limit))) do
            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end
            if not noCooldown then
                local waitTime = GLOBAL_SEND_GAP - (os.clock() - lastPublicSend)
                if waitTime > 0 then task.wait(waitTime) end
            end
            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end
            local outgoing = prefix .. part
            rememberOutgoing(outgoing)
            lastPublicSend = os.clock()
            general:SendAsync(outgoing, BOT_METADATA)
        end
        return true
    end)
    sendLocked = false
    if not ok then return false, tostring(result) end
    return result, detail
end

local function publish(text, prefix, validator)
    local sent, err = sendChat(text, prefix, validator)
    if sent then
        addMessage("BOT", text, PURPLE)
        -- Read the reply aloud when TTS is on (covers chat replies, quizzes,
        -- trivia and every /command answer).
        ttsSpeak(text)
    elseif session.alive and err ~= "Reply canceled." then
        addMessage("ERROR", err, RED)
    end
    return sent
end

local function callProviderModel(messages, maxTokens, model)
    if type(httpRequest) ~= "function" then
        return nil, "HTTP support unavailable."
    end

    local provider = PROVIDERS[selectedProvider]

    local raw = keyBox.Text:gsub("%s", "")
    if provider.requiresKey ~= false and raw == "" then
        return nil, "Enter your " .. provider.keyName .. "."
    end

    local chatUrl, _, token, endpointError = providerEndpoints(provider)
    if not chatUrl then
        return nil, endpointError
    end

    local headers = { ["Content-Type"] = "application/json" }
    if token ~= "" then
        headers["Authorization"] = "Bearer " .. token
    end

    local body = HttpService:JSONEncode({
        model = model.id,
        messages = messages,
        temperature = 0.7,
        max_tokens = maxTokens or 900
    })

    local lastError = httpFailureHint(provider, 0)

    for attempt = 1, 2 do
        local ok, response = pcall(function()
            return httpRequest({
                Url = chatUrl,
                Method = "POST",
                Headers = headers,
                Body = body
            })
        end)

        if ok and type(response) == "table" then
            local decoded, data = pcall(function()
                return HttpService:JSONDecode(response.Body or "")
            end)

            local status = tonumber(response.StatusCode or response.Status) or 0

            if decoded and type(data) == "table"
                and status >= 200 and status < 300 then

                local choice = type(data.choices) == "table" and data.choices[1]
                local message = choice and choice.message
                local content = message and message.content

                -- Reasoning models (DeepSeek R1, QwQ, GPT-OSS) can leave
                -- content empty and put the answer in reasoning_content.
                if type(content) ~= "string" or trim(content) == "" then
                    content = message and message.reasoning_content
                end
                if type(content) ~= "string" or trim(content) == "" then
                    content = data.response
                end

                if type(content) ~= "string" or trim(content) == "" then
                    return nil, "Model returned no text. Try another model."
                end

                -- Store what this reply really cost (data.usage) and any refreshed
                -- remaining allowance the provider sent in its response headers.
                recordTokenUsage(provider, response, data)

                return trim(content)
            end

            if decoded and type(data) == "table"
                and type(data.error) == "table"
                and data.error.message then
                lastError = model.id .. ": " .. tostring(data.error.message)
            elseif decoded and type(data) == "table"
                and type(data.errors) == "table"
                and type(data.errors[1]) == "table"
                and data.errors[1].message then
                -- Cloudflare reports its failures in errors[1].message.
                lastError = model.id .. ": " .. tostring(data.errors[1].message)
            else
                lastError = model.id .. ": " .. httpFailureHint(provider, status)
            end

            if provider.id == "cloudflare" and status == 403 then
                lastError = lastError
                    .. " (this model is not on your Cloudflare plan/token - pick another)"
            elseif provider.id == "cloudflare" and status == 400 then
                lastError = lastError
                    .. " (this model does not support the chat endpoint - pick another)"
            end

            -- Reflect the provider's own quota answer on the GUI line, so it
            -- stops reading "inf" the moment the free allowance is really gone.
            recordQuotaError(provider, lastError, status)

            if status ~= 429 and status < 500 then
                return nil, lastError, (status == 400 or status == 403)
            end
        else
            lastError = httpFailureHint(provider, 0)
        end

        if attempt < 2 and session.alive then
            task.wait(1.5)
        end
    end

    return nil, lastError, false
end

--==================================================
-- AUTOMATIC PROVIDER FAILOVER
--==================================================
-- When a provider runs out of tokens (its free allowance is used up, so
-- recordQuotaError flagged it "exhausted"), the script hops to the next provider
-- in the list that still has a saved key and picks the model chosen for it:
-- Groq -> OpenRouter -> Cohere -> AI Horde -> Synap -> Logfare -> Cloudflare.
-- Google AI Studio is never picked automatically and the last provider does not
-- wrap around to the first.
--
-- These live on the existing "session" table instead of as new top-level locals
-- because this script's main chunk sits right at Luau's 200-register ceiling:
-- extra top-level locals, or closures that capture the model/menu helpers, push
-- the chunk over the limit and it stops compiling.
session.fetchModels = fetchProviderModels
session.rebuildModelMenu = rebuildModelMenu
session.refreshProviderMenu = refreshProviderMenu

-- The model each provider uses when the failover lands on it.
session.failoverModels = {
    groq = "qwen/qwen3.8-27b",
    openrouter = "recursive/flint-v1.0:free",
    aihorde = "ReadyArt/Wicked-Tutu-31B-Final",
    synap = "qwen3-coder-30b",
    logfare = "logfare/auto",
    cloudflare = "@cf/openai/gpt-oss-120b"
}

-- Providers that must never be picked automatically.
session.failoverSkip = {google = true}

-- Finds a model by exact id, then case-insensitive id, then a loose substring
-- match, so a provider-side rename still lands on the intended model.
function session.findModelIndex(provider, wantedId)
    if type(wantedId) ~= "string" or wantedId == "" then return nil end
    local lower = wantedId:lower()

    for index, model in ipairs(provider.models) do
        if type(model.id) == "string" and model.id == wantedId then return index end
    end
    for index, model in ipairs(provider.models) do
        if type(model.id) == "string" and model.id:lower() == lower then return index end
    end
    for index, model in ipairs(provider.models) do
        if type(model.id) == "string" and model.id:lower():find(lower, 1, true) then
            return index
        end
    end
    return nil
end

-- Makes the provider's preferred failover model selectable: returns its index,
-- adding it at the top of the list when the provider does not offer it.
function session.ensurePreferredModel(provider)
    local wanted = session.failoverModels[provider.id]
    if not wanted then return nil end

    local index = session.findModelIndex(provider, wanted)
    if index then return index end

    table.insert(provider.models, 1, {name = wanted, id = wanted, family = "Preferred"})
    return 1
end

-- Moves the GUI to another provider: saves the current key, loads the new
-- provider's free models, selects its failover model and repaints the window.
-- It deliberately does NOT bump the reply/manual versions, so the request that
-- triggered the switch still completes on the new provider.
function session.switchToProvider(index, reason)
    if index == selectedProvider then return false end

    local fromProvider = PROVIDERS[selectedProvider]
    apiKeys[fromProvider.id] = keyBox.Text:gsub("%s", "")

    selectedProvider = index
    local provider = PROVIDERS[index]
    keyBox.Text = apiKeys[provider.id] or ""

    local models = session.fetchModels(provider)
    if type(models) == "table" and #models > 0 then
        provider.models = models
    end

    selectedModel = session.ensurePreferredModel(provider) or 1
    if not provider.models[selectedModel] then selectedModel = 1 end

    providerButton.Text = provider.name
    modelButton.Text = "MODEL: " .. provider.models[selectedModel].name .. "  v"
    session.rebuildModelMenu()
    session.refreshProviderMenu()
    refreshQuotaLabel()

    addMessage("AUTO-SWITCH", (reason or (fromProvider.name .. " is out of tokens"))
        .. " - switched to " .. provider.name .. ", model "
        .. provider.models[selectedModel].id .. ".", ORANGE)

    return true
end

-- Picks the next provider in the list that has a saved key (or needs none) and
-- is not already known to be out of tokens today.
function session.autoSwitchProvider(fromProvider)
    for index = selectedProvider + 1, #PROVIDERS do
        local candidate = PROVIDERS[index]
        if candidate.id ~= fromProvider.id and not session.failoverSkip[candidate.id] then
            local key = apiKeys[candidate.id]
            key = type(key) == "string" and key:gsub("%s", "") or ""
            local usable = candidate.requiresKey == false or key ~= ""
            local record = quotaRecord(candidate)
            if usable and not record.exhausted then
                if session.switchToProvider(index, fromProvider.name .. " is out of tokens") then
                    return true
                end
            end
        end
    end
    return false, "no later provider with a saved key and remaining tokens is available"
end

-- Cloudflare still ships models that answer 400/403 on the chat endpoint, so
-- when the selected model is rejected, quietly try the next couple in the list
-- instead of failing the whole request. Every other provider only tries the one
-- model the user picked. When a provider's free allowance is used up the call
-- hops to the next provider (with its chosen model) and retries there.
local function callProvider(messages, maxTokens)
    local lastError
    local hops = 0

    while session.alive do
        local provider = PROVIDERS[selectedProvider]
        local model = provider.models[selectedModel]
        if not model then
            return nil, "No model selected."
        end

        local candidates = {model}
        if provider.id == "cloudflare" and #provider.models > 1 then
            for offset = 1, math.min(2, #provider.models - 1) do
                candidates[#candidates + 1] =
                    provider.models[((selectedModel - 1 + offset) % #provider.models) + 1]
            end
        end

        for _, candidate in ipairs(candidates) do
            local text, err, rejected = callProviderModel(messages, maxTokens, candidate)
            if text then return text end
            lastError = err
            -- Only a rejected model (400/403) is worth retrying with another one.
            if not rejected then break end
        end

        -- Out of tokens on this provider: hop forward and retry the request.
        if quotaRecord(provider).exhausted then
            hops = hops + 1
            if hops > #PROVIDERS then return nil, lastError end

            local switched, switchError = session.autoSwitchProvider(provider)
            if switched then
                lastError = nil
            else
                return nil, (lastError or "Provider is out of tokens.")
                    .. " (" .. tostring(switchError) .. ")"
            end
        else
            return nil, lastError
        end
    end

    return nil, lastError or "Script stopped."
end

local function askProvider(system, user)
