--==================================================
-- CHAT OUTPUT / LOOP GUARDS
--==================================================

local function normalize(text)
    return trim(text):gsub("%s+", " ")
end

local function rememberOutgoing(text)
    outgoingMessages[normalize(text)] = os.clock() + 120

    for key, expires in pairs(outgoingMessages) do
        if expires < os.clock() then
            outgoingMessages[key] = nil
        end
    end
end

local function isBotOutput(message)
    if message.Metadata == BOT_METADATA then
        return true
    end

    local text = normalize(message.Text)
    local expires = outgoingMessages[text]

    if expires and expires >= os.clock() then
        return true
    end

    return text:lower():match("^commands:") ~= nil
end

local function splitMessage(text, limit)
    local parts = {}
    local remaining = trim(text):gsub("[\r\n]+", " ")

    while remaining ~= "" do
        local cut = utf8.offset(remaining, limit + 1)

        if not cut then
            table.insert(parts, remaining)
            break
        end

        local candidate = remaining:sub(1, cut - 1)
        local space = candidate:match("^.*()%s")

        if space and space > #candidate / 2 then
            table.insert(parts, trim(remaining:sub(1, space - 1)))
            remaining = trim(remaining:sub(space + 1))
        else
            table.insert(parts, candidate)
            remaining = trim(remaining:sub(cut))
        end
    end

    return parts
end

local function sendChat(text, prefix, validator)
    while sendLocked and session.alive do
        task.wait(0.05)
    end

    if not session.alive then
        return false, "Script stopped."
    end

    sendLocked = true

    local ok, result, detail = pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        local general = channels and channels:FindFirstChild("RBXGeneral")

        if not general then
            return false, "RBXGeneral unavailable."
        end

        prefix = prefix or ""
        local limit = 180 - (utf8.len(prefix) or #prefix)

        for _, part in ipairs(splitMessage(text, math.max(40, limit))) do
            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end

            -- NOCD: skip the global send gap when enabled.
            if not noCooldown then
                local waitTime = GLOBAL_SEND_GAP - (os.clock() - lastPublicSend)

                if waitTime > 0 then
                    task.wait(waitTime)
                end
            end

            if not session.alive or (validator and not validator()) then
                return false, "Reply canceled."
            end

            local outgoing = prefix .. part

            rememberOutgoing(outgoing)
            lastPublicSend = os.clock()
            general:SendAsync(outgoing, BOT_METADATA)
        end

        return true
    end)

    sendLocked = false

    if not ok then
        return false, tostring(result)
    end

    return result, detail
end

local function publish(text, prefix, validator)
    local sent, err = sendChat(text, prefix, validator)

    if sent then
        addMessage("BOT", text, PURPLE)
    elseif session.alive and err ~= "Reply canceled." then
        addMessage("ERROR", err, RED)
    end

    return sent
end

